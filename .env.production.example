# Copy to .env.production for production builds (gitignored).
# Must include /api — see frontend/src/lib/apiBaseUrl.ts
NEXT_PUBLIC_API_URL=https://gatepass-v037.onrender.com/api
# E1 — HttpOnly auth defaults on in production builds (set false to use localStorage JWT)
# NEXT_PUBLIC_HTTPONLY_AUTH=false
# Error reporting (optional). Without this, Sentry is a no-op in the admin web app.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o000000.ingest.sentry.io/000000
